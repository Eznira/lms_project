      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{access_token}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const accessToken = pm.environment.get(\"access_token\");\r",
              "const refreshToken = pm.environment.get(\"refresh_token\");\r",
              "\r",
              "pm.environment.set(\r",
              "    \"target_request\",\r",
              "    pm.info.requestName\r",
              ");\r",
              "\r",
              "if (!accessToken) {\r",
              "    console.log(\"No access token. Please login first.\");\r",
              "    return;\r",
              "}\r",
              "\r",
              "function decodeJwt(token) {\r",
              "    const payload = token.split(\".\")[1];\r",
              "    return JSON.parse(atob(payload));\r",
              "}\r",
              "\r",
              "try {\r",
              "    const payload = decodeJwt(accessToken);\r",
              "    const now = Math.floor(Date.now() / 1000);\r",
              "\r",
              "    if (payload.exp > now + 30) {\r",
              "        console.log(\"Access token is valid.\");\r",
              "        return;\r",
              "    }\r",
              "\r",
              "    console.log(\"Access token expired. Refreshing...\");\r",
              "\r",
              "    if (!refreshToken) {\r",
              "        throw new Error(\"No refresh token available.\");\r",
              "    }\r",
              "\r",
              "    pm.execution.setNextRequest(\"Refresh Token\");\r",
              "\r",
              "} catch (error) {\r",
              "    console.error(\"JWT error:\", error.message);\r",
              "}"
            ]
          }
        },
